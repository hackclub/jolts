# GitHub OAuth app that the visual editor saves through.
#
# Create one at https://github.com/settings/developers → New OAuth App:
#   Homepage URL:               https://jolts.hackclub.com
#   Authorization callback URL: https://jolts.hackclub.com/api/github/callback
#
# Add a second OAuth app (or a second callback URL) for local development:
#   http://localhost:3000/api/github/callback
#
# The client secret doubles as the key that seals the contributor's access
# token into its cookie, so rotating it signs everyone out - which is the
# behaviour you want.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
